{
  "expo": {
    "name": "react-native-nfc-x-example",
    "slug": "react-native-nfc-x-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "expo.modules.nfcx.example"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "expo.modules.nfcx.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-nfc-x",
        {
          "ios": {
            "nfcReaderUsageDescription": "This app uses NFC to read and write tags for testing react-native-nfc-x."
          },
          "android": {
            "hce": {
              "aidGroups": [
                {
                  "category": "other",
                  "description": "react-native-nfc-x example HCE applet",
                  "aids": ["F0010203040506"]
                }
              ]
            }
          }
        }
      ]
    ]
  }
}