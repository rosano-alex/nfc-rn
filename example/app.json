{
  "expo": {
    "name": "nfc-rn-example",
    "slug": "nfc-rn-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "expo.modules.nfcx.example"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "expo.modules.nfcx.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "nfc-rn",
        {
          "ios": {
            "nfcReaderUsageDescription": "This app uses NFC to read and write tags for testing nfc-rn."
          },
          "android": {
            "hce": {
              "aidGroups": [
                {
                  "category": "other",
                  "description": "nfc-rn example HCE applet",
                  "aids": [
                    "F0010203040506"
                  ]
                }
              ]
            }
          }
        }
      ]
    ]
  }
}
